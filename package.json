{
  "name": "@xtnd-dynamics/xtnd-workspace-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run check && npm run test"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "@types/node": "^24.0.0"
  }
}
